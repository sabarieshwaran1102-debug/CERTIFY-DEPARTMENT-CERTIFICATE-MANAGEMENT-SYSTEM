# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=certificate_management
DB_USER=postgres
DB_PASSWORD=change-me-strong-password

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRY=30m

# File Storage Configuration
STORAGE_PATH=../storage/certificates
MAX_FILE_SIZE=5242880

# Authentication Configuration
# Note: Authentication method is pending department confirmation
# Placeholder for future implementation
AUTH_METHOD=placeholder

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Email Configuration (optional — leave blank to disable email notifications)
EMAIL_ENABLED=false
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=CERTIFY <noreply@certify.local>
